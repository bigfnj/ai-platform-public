# Copy to .env and edit as needed. All optional; defaults shown.

# Where the broker listens is NOT set here: it is uvicorn's command line. The installed
# service (deploy/install-services.ps1) binds 0.0.0.0:11500 so the rail containers can reach
# it, which makes the broker reachable from the LAN too. Set BROKER_AUTH_TOKEN (below) on any
# box that is not single-user.
#
# Shared secret for every /v1/* and /openai/v1/* route. Empty = open.
# BROKER_AUTH_TOKEN=

# Backend GPU model server.
BROKER_OLLAMA_BASE_URL=http://127.0.0.1:11434
BROKER_OLLAMA_TIMEOUT=600

# keep_alive applied by /v1/load when the caller sends none. The default unloads a manually
# loaded model after 30 idle minutes; -1 would keep it resident until something evicts it.
BROKER_DEFAULT_LOAD_KEEP_ALIVE=30m

# Substrings that mark a model name as an embedding model (light).
BROKER_EMBED_NAME_HINTS=embed,bge,nomic-embed,mxbai,gte,e5,minilm

# --- media worker: THREE interpreters, because three stacks that cannot coexist ---------
#
# <ai-work> in the paths below is the folder two levels above this checkout, the root the
# media-venv default in app/config.py is built from (<ai-work>\venvs\media-venv).
#
# Media inference runs in a short-lived subprocess so VRAM is reclaimed on exit. Which
# interpreter runs it depends on the op, and the splits are forced by real conflicts, not
# tidiness. An unset one falls back to BROKER_MEDIA_PYTHON, so a single-venv install works.
#
#   image / embed_image  -> BROKER_MEDIA_PYTHON   torch+cuNNN, diffusers, transformers 5.5.4
#   tts / tts_batch      -> BROKER_TTS_PYTHON     coqui-tts, which needs transformers <5
#   kokoro_tts           -> BROKER_KOKORO_PYTHON  kokoro-onnx, which needs numpy >= 2.0.2
#
# The numpy split is the sharpest: kokoro-onnx requires numpy>=2.0.2 while
# simple-lama-inpainting (image inpainting) requires numpy<2.0.0. Installing Kokoro into the
# media venv silently upgrades numpy underneath recipe-book icons, edu-suite images and
# bouquet vision. That venv has been broken this way before; keep them apart.
#
# BROKER_MEDIA_ENABLED=true
# BROKER_MEDIA_PYTHON=<ai-work>\venvs\media-venv\Scripts\python.exe
# BROKER_TTS_PYTHON=<ai-work>\venvs\tts-venv\Scripts\python.exe
#
# Image embedders /v1/embed_image may load (Hugging Face ids, comma-separated; the first is
# the default). An allowlist, because the id is downloaded into the HF cache on first use.
# BROKER_IMAGE_EMBED_MODELS=google/siglip2-base-patch16-384

# --- Kokoro-82M light TTS (platform-wide read-aloud) ------------------------------------
# ~350 MB ONNX, CPU, torch-free. Runs with NO GPU gate and evicts nothing, so a rail can
# voice a block of text without displacing the model someone is chatting with. Set up with:
#   python -m venv <ai-work>\venvs\kokoro-venv
#   <ai-work>\venvs\kokoro-venv\Scripts\python -m pip install kokoro-onnx onnxruntime soundfile
# Weights (~340 MB total) from the kokoro-onnx release `model-files-v1.0`:
#   kokoro-v1.0.onnx, voices-v1.0.bin
# Leave the paths empty to disable /v1/tts_light; it 502s naming these vars.
#
# NOT a replacement for the XTTS `tts` op, which clones a voice from a reference clip and
# returns per-segment timings for highlight-sync. Kokoro does neither. Both stay.
# BROKER_KOKORO_PYTHON=<ai-work>\venvs\kokoro-venv\Scripts\python.exe
# BROKER_KOKORO_MODEL_PATH=<ai-work>\models\kokoro\kokoro-v1.0.onnx
# BROKER_KOKORO_VOICES_PATH=<ai-work>\models\kokoro\voices-v1.0.bin

# --- faster-whisper STT (platform-wide dictation) ---------------------------------------
# Also no gate, no eviction, for a sharper reason: the user has just stopped talking and is
# waiting. CPU/int8 keeps it off the card; a short utterance is ~1-4 s.
#
# Torch-free (CTranslate2), so it SHARES the Kokoro venv rather than needing a fourth —
# verified no numpy conflict:
#   <ai-work>\venvs\kokoro-venv\Scripts\python -m pip install faster-whisper
# BROKER_WHISPER_PYTHON is therefore left unset; it falls back to BROKER_KOKORO_PYTHON. Set
# it only if the two ever need splitting.
#
# ⚠ USE THE MULTILINGUAL MODEL. The `.en` variants are English-ONLY: they ignore `language`
# ("using 'en' instead") and turn Spanish into nonsense. Measured here, small.en rendered
# "El estudiante identificará la idea central de un texto de su nivel" as "de estudiante ...
# de cunibel", while multilingual small returned it verbatim — and faster (2.0s vs 5.0s),
# since it is not fighting the language. English costs ~1.6s. This platform is bilingual.
#
# Weights (~500 MB, Systran/faster-whisper-small) download to the HF cache on the first
# call, so a cold install needs one online request.
BROKER_WHISPER_MODEL=small
BROKER_WHISPER_DEVICE=cpu
BROKER_WHISPER_COMPUTE_TYPE=int8

# --- Claude CLI backend (owner-only, off by default) -------------------------------------
# Serves an owner's own requests for the listed roles through their Claude subscription, and
# everyone else's through the local model. The broker holds ONE Claude credential, so every
# name in BROKER_CLI_OWNERS must be one of that one subscriber's own platform accounts: listing
# another person would serve them on the subscriber's plan, which the subscription terms forbid.
# Every value below is required for it to engage; GET /v1/status `cli.blockers` names whichever
# is missing.
# BROKER_CLI_ENABLED=false
# BROKER_CLI_OWNERS=            # the subscriber's OWN platform usernames, comma-separated, matched EXACTLY (case too)
# BROKER_CLI_ROLES=             # role names without @, comma-separated, e.g. recipe
# BROKER_CLI_WORKDIR=           # an EMPTY directory; unset is the workdir_unset blocker
# BROKER_CLI_EXE=               # absolute path to claude.exe; empty = found on PATH / npm root
# BROKER_CLI_OAUTH_TOKEN_FILE=  # a `claude setup-token` token, for a service account
# BROKER_CLI_TIMEOUT=180        # seconds one CLI call may take before it falls back
# Optional:
# BROKER_CLI_MODEL=             # the model for a role the Rails tab gave none; empty = the CLI's own default
# BROKER_CLI_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5  # the models the Rails tab may give a role
# BROKER_CLI_ROLES_FILE=        # the Rails tab's per-role switches (JSON); unset = BROKER_CLI_ROLES alone
# BROKER_CLI_CONCURRENCY=2      # CLI calls at once; the rest wait inside BROKER_CLI_TIMEOUT
# BROKER_CLI_TEMP_ROOT=         # where each call's own TEMP is made and removed; empty = cli-tmp beside the workdir
