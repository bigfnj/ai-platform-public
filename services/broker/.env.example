# Copy to .env and edit as needed. All optional; defaults shown.

# Where the broker listens (internal only by default).
BROKER_HOST=127.0.0.1
BROKER_PORT=11500

# Backend GPU model server.
BROKER_OLLAMA_BASE_URL=http://127.0.0.1:11434
BROKER_OLLAMA_TIMEOUT=600

# keep_alive applied by /v1/load. -1 = resident indefinitely.
BROKER_DEFAULT_LOAD_KEEP_ALIVE=-1

# Substrings that mark a model name as an embedding model (light).
BROKER_EMBED_NAME_HINTS=embed,bge,nomic-embed,mxbai,gte,e5,minilm

# --- media worker (voice / image) ------------------------------------------
# Media inference runs in a short-lived subprocess so VRAM is reclaimed on exit.
# BROKER_MEDIA_PYTHON must point at an interpreter that has the media deps installed.
# BROKER_MEDIA_ENABLED=true
# BROKER_MEDIA_PYTHON=C:/path/to/services/broker/media-venv/Scripts/python.exe

# Kokoro-82M TTS (no GPU gate, no eviction) — needs kokoro-onnx + onnxruntime[-directml].
# BROKER_KOKORO_MODEL_PATH=C:/path/to/media-assets/kokoro/kokoro-v1.0.fp16-gpu.onnx
# BROKER_KOKORO_VOICES_PATH=C:/path/to/media-assets/kokoro/voices-v1.0.bin

# faster-whisper STT (no GPU gate, no eviction). CPU/int8 by design: speech input must not
# compete for VRAM with the resident RAG model, and a short question still transcribes in
# ~1.7s. Install into the media venv with `uv pip install faster-whisper`; weights are pulled
# from the HuggingFace cache on the first call (Systran/faster-whisper-small.en, ~484 MB).
BROKER_WHISPER_MODEL=small.en
BROKER_WHISPER_DEVICE=cpu
BROKER_WHISPER_COMPUTE_TYPE=int8
