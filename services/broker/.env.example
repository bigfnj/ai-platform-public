# Copy to .env and edit as needed. All optional; defaults shown.

# Where the broker listens (internal only by default).
BROKER_HOST=127.0.0.1
BROKER_PORT=11500

# Backend GPU model server.
BROKER_OLLAMA_BASE_URL=http://127.0.0.1:11434
BROKER_OLLAMA_TIMEOUT=600

# keep_alive applied by /v1/load. -1 = resident indefinitely.
BROKER_DEFAULT_LOAD_KEEP_ALIVE=-1

# Substrings that mark a model name as an embedding model (light).
BROKER_EMBED_NAME_HINTS=embed,bge,nomic-embed,mxbai,gte,e5,minilm
