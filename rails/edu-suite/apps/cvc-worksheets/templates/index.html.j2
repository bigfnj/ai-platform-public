<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CVC Words Worksheets</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Edu+NSW+ACT+Foundation:wght@400;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════
   ROOT + RESET
═══════════════════════════════════════════════ */
:root {
  --font-body: 'Nunito', sans-serif;
  --font-trace: 'Edu NSW ACT Foundation', cursive;
  --nav-h: 60px;
  --page-bg: #f8f9fb;
  --card-bg: #ffffff;
  --border: #e2e8f0;
  --text: #1e293b;
  --text-muted: #64748b;
  --shadow: 0 2px 12px rgba(0,0,0,0.08);
  --radius: 12px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font-body); background: var(--page-bg); color: var(--text); }

/* ═══════════════════════════════════════════════
   TOP NAV (screen only)
═══════════════════════════════════════════════ */
.top-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  height: var(--nav-h);
  background: #1e293b;
  display: flex; align-items: center; gap: 6px;
  padding: 0 16px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.3);
}
.nav-logo {
  font-size: 15px; font-weight: 800; color: #fff;
  margin-right: 8px; white-space: nowrap; letter-spacing: 0.5px;
}
.nav-btn {
  background: transparent; border: 1.5px solid rgba(255,255,255,0.25);
  color: #cbd5e1; border-radius: 8px;
  padding: 5px 12px; font-size: 13px; font-family: var(--font-body);
  font-weight: 600; cursor: pointer; white-space: nowrap;
  transition: all 0.15s;
}
.nav-btn:hover, .nav-btn.active { background: rgba(255,255,255,0.15); color: #fff; border-color: rgba(255,255,255,0.5); }
.nav-btn.ws-btn { border-color: transparent; }
{% for ws in worksheets %}
.nav-btn.ws-btn[data-ws="{{ ws.number }}"] {
  border-left: 3px solid {{ ws.color.primary }};
}
{% endfor %}

.search-wrap { position: relative; margin-left: auto; }
#search-input {
  background: rgba(255,255,255,0.1); border: 1.5px solid rgba(255,255,255,0.25);
  color: #fff; border-radius: 8px; padding: 6px 12px 6px 32px;
  font-size: 13px; font-family: var(--font-body); width: 180px;
  outline: none; transition: all 0.15s;
}
#search-input::placeholder { color: rgba(255,255,255,0.4); }
#search-input:focus { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.6); width: 220px; }
.search-icon {
  position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
  color: rgba(255,255,255,0.45); font-size: 14px; pointer-events: none;
}
#search-dropdown {
  position: absolute; top: calc(100% + 6px); right: 0;
  background: #fff; border: 1px solid var(--border); border-radius: 10px;
  box-shadow: var(--shadow); min-width: 160px; z-index: 200; overflow: hidden;
}
.search-result {
  padding: 9px 14px; font-size: 14px; font-weight: 600; cursor: pointer;
  display: flex; align-items: center; gap: 8px; transition: background 0.1s;
}
.search-result:hover { background: #f1f5f9; }
.search-result .sr-ws { font-size: 11px; color: var(--text-muted); font-weight: 400; margin-left: auto; }

/* ═══════════════════════════════════════════════
   VIEWS
═══════════════════════════════════════════════ */
.view { display: none; padding-top: var(--nav-h); min-height: 100vh; }
.view.active { display: block; }

/* ═══════════════════════════════════════════════
   HOME / LANDING
═══════════════════════════════════════════════ */
#home { padding-bottom: 60px; }
#home-inner { max-width: 900px; margin: 0 auto; padding: 40px 24px 0; }
.home-header { text-align: center; margin-bottom: 36px; }
.home-header h1 { font-size: 32px; font-weight: 800; color: #1e293b; line-height: 1.2; }
.home-header p { font-size: 16px; color: var(--text-muted); margin-top: 8px; }

.ws-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
.ws-card {
  background: var(--card-bg); border: 2px solid var(--border);
  border-radius: var(--radius); padding: 20px 22px;
  cursor: pointer; transition: all 0.15s; box-shadow: var(--shadow);
  border-top: 5px solid var(--card-accent, #e2e8f0);
}
.ws-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
.ws-card h2 { font-size: 20px; font-weight: 800; margin-bottom: 4px; }
.ws-card .vowel-badge {
  display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.5px;
  padding: 2px 10px; border-radius: 20px; margin-bottom: 12px;
  background: var(--card-light); color: var(--card-accent);
}
.ws-card .word-pills { display: flex; flex-wrap: wrap; gap: 6px; }
.ws-card .word-pill {
  font-size: 13px; font-weight: 700; padding: 3px 10px;
  border-radius: 20px; background: var(--card-light);
  color: var(--card-accent); border: 1px solid var(--card-border);
}
{% for ws in worksheets %}
.ws-card[data-ws="{{ ws.number }}"] {
  --card-accent: {{ ws.color.primary }};
  --card-light: {{ ws.color.light }};
  --card-border: {{ ws.color.border }};
}
{% endfor %}

/* ═══════════════════════════════════════════════
   WORKSHEET SECTION (screen)
═══════════════════════════════════════════════ */
.worksheet-section { padding-bottom: 60px; }
.ws-toolbar {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 24px; background: #fff;
  border-bottom: 1px solid var(--border); position: sticky;
  top: var(--nav-h); z-index: 50;
}
.ws-toolbar h2 { font-size: 18px; font-weight: 800; flex: 1; }
.ws-toolbar .vowel-chip {
  font-size: 13px; font-weight: 700; padding: 3px 12px;
  border-radius: 20px;
}
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  border: none; border-radius: 8px; padding: 8px 16px;
  font-size: 13px; font-weight: 700; font-family: var(--font-body);
  cursor: pointer; transition: all 0.15s;
}
.btn-ghost { background: #f1f5f9; color: #475569; }
.btn-ghost:hover { background: #e2e8f0; }
.btn-primary { background: #1e293b; color: #fff; }
.btn-primary:hover { background: #334155; }

.print-pages { display: flex; flex-direction: column; gap: 32px; padding: 24px; max-width: 900px; margin: 0 auto; }

/* ═══════════════════════════════════════════════
   PRINT PAGE CARD (screen preview)
═══════════════════════════════════════════════ */
.print-page {
  background: #fff; border: 1px solid var(--border);
  border-radius: var(--radius); box-shadow: var(--shadow);
  padding: 28px 32px; position: relative;
}
.page-header {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 12px; margin-bottom: 20px;
  border-bottom: 3px solid var(--ws-color, #e2e8f0);
}
.page-header .ws-title { font-size: 15px; font-weight: 800; color: var(--ws-color, #555); }
.page-header .page-num { font-size: 13px; color: var(--text-muted); font-weight: 600; }

/* ═══════════════════════════════════════════════
   WORD BLOCK
═══════════════════════════════════════════════ */
.word-block {
  display: grid; grid-template-columns: 130px 1fr;
  grid-template-rows: auto auto auto;
  column-gap: 20px; row-gap: 0;
  padding: 16px 0; border-bottom: 1px dashed #e2e8f0;
  transition: background 0.3s; border-radius: 8px; padding: 14px 10px;
}
.word-block:last-child { border-bottom: none; }
.word-block.word-highlight { background: #fefce8; }

.word-img {
  grid-row: 1 / 3; grid-column: 1;
  width: 120px; height: 120px;
  border-radius: 10px; overflow: hidden;
  border: 2px solid var(--ws-color, #e2e8f0);
  display: flex; align-items: center; justify-content: center;
  background: #ffffff; padding: 6px;
}
.word-img img { width: 100%; height: 100%; object-fit: contain; display: block; }

.word-labels { grid-row: 1; grid-column: 2; padding-top: 4px; }
.word-en {
  font-size: 44px; font-weight: 800; line-height: 1;
  color: var(--ws-color, #1e293b); letter-spacing: 1px;
  font-family: var(--font-body);
}
.word-es {
  font-size: 22px; font-weight: 600; color: var(--text-muted);
  margin-top: 4px; font-style: italic;
}

.word-audio { grid-row: 1; grid-column: 2; display: flex; gap: 8px; align-items: flex-end; padding-bottom: 6px; justify-content: flex-end; }
.audio-btn {
  background: var(--ws-light, #f1f5f9);
  border: 1.5px solid var(--ws-border, #e2e8f0);
  border-radius: 20px; padding: 4px 12px;
  font-size: 12px; font-weight: 700; cursor: pointer;
  color: var(--ws-color, #475569); transition: all 0.1s;
  font-family: var(--font-body);
}
.audio-btn:hover { background: var(--ws-color, #e2e8f0); color: #fff; }
.audio-btn:disabled { opacity: 0.35; cursor: not-allowed; }

/* Reflow for audio buttons — put them bottom-right of label area */
.word-content { grid-row: 1; grid-column: 2; display: flex; flex-direction: column; justify-content: space-between; }

.trace-area { grid-row: 2; grid-column: 2; margin-top: 12px; }
.trace-label { font-size: 11px; font-weight: 700; letter-spacing: 0.8px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
.trace-letters { display: flex; gap: 8px; flex-wrap: wrap; }
.trace-letter {
  font-family: var(--font-trace);
  font-size: 62px; font-weight: 700;
  color: rgba(0,0,0,0.12);
  width: 72px; height: 80px;
  display: inline-flex; align-items: center; justify-content: center;
  border: 2px dashed #d1d5db; border-radius: 8px;
  line-height: 1; user-select: none;
}

.write-area { grid-row: 3; grid-column: 1 / 3; margin-top: 10px; }
.write-label { font-size: 11px; font-weight: 700; letter-spacing: 0.8px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px; }
.write-lines { display: flex; flex-direction: column; gap: 0; }
.write-line {
  height: 38px;
  border-bottom: 2px solid #9ca3af;
  border-top: none; position: relative;
}
.write-line::after {
  content: ''; position: absolute;
  top: 50%; left: 0; right: 0;
  border-top: 1px dashed #d1d5db;
}

{% for ws in worksheets %}
.ws-{{ ws.number }} {
  --ws-color: {{ ws.color.primary }};
  --ws-light: {{ ws.color.light }};
  --ws-border: {{ ws.color.border }};
}
{% endfor %}

/* ═══════════════════════════════════════════════
   PRINT STYLES
═══════════════════════════════════════════════ */
@media print {
  .top-nav, .ws-toolbar, .word-audio, .audio-btn, .btn { display: none !important; }

  body { background: #fff; }

  /* Page margins handled by the paging engine (not element padding) so
     content height = 11in - 1in = 10in (~960px) — the number we size to. */
  @page { size: letter portrait; margin: 0.5in; }

  /* Reset all screen layout on the view container */
  .view { display: none !important; padding-top: 0 !important; min-height: 0 !important; }

  /* Show only the target worksheet (data-print set by the Print button) */
  body[data-print="all"] .view.active { display: block !important; }
  {% for ws in worksheets %}
  body[data-print="{{ ws.number }}"] #worksheet-{{ ws.number }} { display: block !important; }
  {% endfor %}

  /* Flex gap/padding on this container injected blank space between pages
     in print context — force plain block flow. */
  .print-pages {
    display: block !important;
    padding: 0 !important;
    margin: 0 !important;
    max-width: none !important;
  }

  /* Each logical page = exactly one physical sheet. No fixed height: let
     content flow naturally (it now fits well under 960px), then force the
     break. overflow:hidden is a safety net against 1px rounding spills. */
  .print-page {
    border: none !important; box-shadow: none !important; border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block;
    overflow: hidden;
    page-break-after: always;
    break-after: page;
    page-break-inside: avoid;
  }
  .print-page:last-child { page-break-after: auto; break-after: auto; }

  /* ── Compact word blocks so 3 + header fit one sheet (~790px < 960px) ── */
  .page-header { border-bottom-color: var(--ws-color); margin-bottom: 14px; padding-bottom: 8px; }

  .word-block {
    padding: 8px 0 !important;
    border-bottom: 1px dashed #ccc;
    page-break-inside: avoid;
    break-inside: avoid;
    grid-template-columns: 110px 1fr;
    column-gap: 18px;
  }
  .word-block:last-child { border-bottom: none; }

  .word-img { width: 100px; height: 100px; }
  .word-en { font-size: 40px; }
  .word-es { font-size: 20px; }

  .trace-area { margin-top: 8px; }
  .trace-letter {
    font-size: 46px; width: 58px; height: 62px;
    color: rgba(0,0,0,0.14); border-color: #ccc;
  }

  .write-area { margin-top: 6px; }
  .write-line { height: 30px; }
}

</style>
</head>
<body>

<!-- ═══ TOP NAV ═══ -->
<nav class="top-nav screen-only">
  <span class="nav-logo">📖 CVC Words</span>
  <button class="nav-btn active" id="nav-home" onclick="showHome()">Home</button>
  {% for ws in worksheets %}
  <button class="nav-btn ws-btn" data-ws="{{ ws.number }}" id="nav-ws-{{ ws.number }}"
    onclick="showWorksheet({{ ws.number }})"
    style="border-left-color: {{ ws.color.primary }}">
    WS {{ ws.number }} · /{{ ws.vowel }}/
  </button>
  {% endfor %}
  <div class="search-wrap">
    <span class="search-icon">🔍</span>
    <input type="text" id="search-input" placeholder="Jump to word…"
      oninput="handleSearch(this)" onkeydown="handleSearchKey(event)"
      autocomplete="off" spellcheck="false">
    <div id="search-dropdown"></div>
  </div>
</nav>

<!-- ═══ HOME ═══ -->
<section id="home" class="view active">
  <div id="home-inner">
    <div class="home-header">
      <h1>CVC Words Practice Worksheets</h1>
      <p>5 worksheets · 30 words · Short vowel sounds · English &amp; Spanish</p>
    </div>
    <div class="ws-grid">
      {% for ws in worksheets %}
      <div class="ws-card" data-ws="{{ ws.number }}" onclick="showWorksheet({{ ws.number }})">
        <h2>Worksheet {{ ws.number }}</h2>
        <span class="vowel-badge" style="background:{{ ws.color.light }};color:{{ ws.color.primary }}">
          Short /{{ ws.vowel }}/ sound
        </span>
        <div class="word-pills">
          {% for word in ws.words %}
          <span class="word-pill">{{ word.en }}</span>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══ WORKSHEETS ═══ -->
{% for ws in worksheets %}
<section id="worksheet-{{ ws.number }}" class="view worksheet-section ws-{{ ws.number }}">

  <div class="ws-toolbar">
    <button class="btn btn-ghost" onclick="showHome()">← Home</button>
    <h2 style="color: {{ ws.color.primary }}">Worksheet {{ ws.number }}</h2>
    <span class="vowel-chip"
      style="background:{{ ws.color.light }};color:{{ ws.color.primary }};border:1.5px solid {{ ws.color.border }}">
      Short /{{ ws.vowel }}/
    </span>
    <span style="flex:1"></span>
    <button class="btn btn-ghost"
      onclick="navigateWorksheet(-1, {{ ws.number }})"
      {% if ws.number == 1 %}disabled{% endif %}>‹ Prev</button>
    <button class="btn btn-ghost"
      onclick="navigateWorksheet(1, {{ ws.number }})"
      {% if ws.number == worksheets|length %}disabled{% endif %}>Next ›</button>
    <button class="btn btn-primary" onclick="printWorksheet({{ ws.number }})">🖨 Print</button>
  </div>

  <div class="print-pages">
    {% for page in ws.pages %}
    <div class="print-page" id="ws{{ ws.number }}-p{{ page.number }}">
      <div class="page-header">
        <span class="ws-title" style="color:{{ ws.color.primary }}">
          Worksheet {{ ws.number }} — Short /{{ ws.vowel }}/ sound
        </span>
        <span class="page-num">Page {{ page.number }} of 2</span>
      </div>

      {% for word in page.words %}
      <div class="word-block" id="word-{{ word.en }}">

        <div class="word-img">
          {% if word.has_image %}
          <img src="{% if word.image_path %}{{ word.image_path }}{% else %}{{ word.image_b64 }}{% endif %}" alt="{{ word.en }}">
          {% else %}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;
            background:{{ ws.color.light }};font-size:42px;font-weight:800;color:{{ ws.color.primary }};
            font-family:var(--font-body)">{{ word.en }}</div>
          {% endif %}
        </div>

        <div class="word-content">
          <div class="word-labels">
            <div class="word-en">{{ word.en }}</div>
            <div class="word-es">{{ word.es if word.es else '…' }}</div>
          </div>
          <div class="word-audio">
            {% if word.has_audio %}
            <button class="audio-btn" onclick="playAudio('{{ word.en }}','en')" title="Hear in English">▶ English</button>
            <button class="audio-btn" onclick="playAudio('{{ word.en }}','es')" title="Oír en español">▶ Español</button>
            {% else %}
            <button class="audio-btn" disabled title="Audio not generated yet">▶ English</button>
            <button class="audio-btn" disabled title="Audio not generated yet">▶ Español</button>
            {% endif %}
          </div>
        </div>

        <div class="trace-area">
          <div class="trace-label">Trace each letter</div>
          <div class="trace-letters">
            {% for letter in word.en %}
            <div class="trace-letter">{{ letter }}</div>
            {% endfor %}
          </div>
        </div>

        <div class="write-area">
          <div class="write-label">Write the word</div>
          <div class="write-lines">
            <div class="write-line"></div>
            <div class="write-line"></div>
          </div>
        </div>

      </div><!-- .word-block -->
      {% endfor %}

    </div><!-- .print-page -->
    {% endfor %}
  </div><!-- .print-pages -->

</section>
{% endfor %}

<!-- ═══ HIDDEN AUDIO ELEMENTS ═══ -->
{% for word in all_words %}
{% if word.has_audio %}
<audio id="audio-{{ word.en }}-en" src="{% if word.audio_en_path %}{{ word.audio_en_path }}{% else %}data:audio/wav;base64,{{ word.audio_en_b64 }}{% endif %}" preload="none"></audio>
<audio id="audio-{{ word.en }}-es" src="{% if word.audio_es_path %}{{ word.audio_es_path }}{% else %}data:audio/wav;base64,{{ word.audio_es_b64 }}{% endif %}" preload="none"></audio>
{% endif %}
{% endfor %}

<script>
// ═══ DATA ═══
const WORD_TO_WS = {{ word_to_worksheet | tojson_safe }};
const ALL_WORDS  = {{ all_word_ids | tojson_safe }};
const WS_COUNT   = {{ worksheets | length }};

// ═══ NAVIGATION ═══
let currentView = 'home';

function setView(id) {
  document.querySelectorAll('.view').forEach(el => el.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  const navBtn = document.getElementById('nav-' + id.replace('worksheet-', 'ws-'));
  if (navBtn) navBtn.classList.add('active');
  else document.getElementById('nav-home').classList.add('active');
  window.scrollTo({ top: 0 });
  currentView = id;
}

function showHome() { setView('home'); }
function showWorksheet(n) { setView('worksheet-' + n); }
function navigateWorksheet(delta, current) {
  const next = current + delta;
  if (next >= 1 && next <= WS_COUNT) showWorksheet(next);
}

// ═══ PRINT ═══
function printWorksheet(n) {
  document.body.dataset.print = n;
  window.print();
  delete document.body.dataset.print;
}

// ═══ WORD SEARCH ═══
function handleSearch(input) {
  const val = input.value.toLowerCase().trim();
  const dd = document.getElementById('search-dropdown');
  if (!val) { dd.innerHTML = ''; return; }

  const matches = ALL_WORDS.filter(w => w.includes(val)).slice(0, 8);
  if (!matches.length) { dd.innerHTML = ''; return; }

  dd.innerHTML = matches.map(w =>
    `<div class="search-result" onclick="jumpToWord('${w}')">
       ${highlightMatch(w, val)}
       <span class="sr-ws">WS ${WORD_TO_WS[w]}</span>
     </div>`
  ).join('');
}

function handleSearchKey(e) {
  if (e.key === 'Enter') {
    const val = e.target.value.toLowerCase().trim();
    const match = ALL_WORDS.find(w => w === val);
    if (match) jumpToWord(match);
    e.target.blur();
  }
  if (e.key === 'Escape') {
    document.getElementById('search-dropdown').innerHTML = '';
    e.target.blur();
  }
}

function highlightMatch(word, query) {
  const idx = word.indexOf(query);
  if (idx === -1) return word;
  return word.slice(0, idx)
    + '<strong>' + word.slice(idx, idx + query.length) + '</strong>'
    + word.slice(idx + query.length);
}

function jumpToWord(word) {
  document.getElementById('search-input').value = word;
  document.getElementById('search-dropdown').innerHTML = '';

  const ws = WORD_TO_WS[word];
  showWorksheet(ws);

  requestAnimationFrame(() => {
    const el = document.getElementById('word-' + word);
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('word-highlight');
    setTimeout(() => el.classList.remove('word-highlight'), 2200);
  });
}

// Close dropdown when clicking outside
document.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) {
    document.getElementById('search-dropdown').innerHTML = '';
  }
});

// ═══ AUDIO ═══
function playAudio(word, lang) {
  const el = document.getElementById('audio-' + word + '-' + lang);
  if (el) { el.currentTime = 0; el.play(); }
}
</script>
</body>
</html>
