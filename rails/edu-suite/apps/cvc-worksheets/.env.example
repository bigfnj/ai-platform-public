# Ollama host — default is localhost:11434
# Set this if Ollama is running elsewhere (e.g. WSL before Windows install)
OLLAMA_HOST=http://localhost:11434

# Reference voice clips for XTTS v2. Defaults to <repo-root>/shared/voices.
# Only set this to override that location.
# VOICES_DIR=/absolute/path/to/shared/voices
