# Meeting Atlas backend — copy to .env for local dev, or set these on the container
# (see deploy/docker-compose.yml). Env prefix is MEETING_ATLAS_.

# --- the recordings tree --------------------------------------------------------
# One directory per meeting, each holding transcripts.json (+ metadata.json, audio.mp4).
# Bind-mounted READ-ONLY: this backend never writes here. On the host this is
# C:\Users\<you>\Music\meetily-recordings.
MEETING_ATLAS_RECORDINGS_DIR=/data/recordings

# --- the Meetily database (OPTIONAL) --------------------------------------------
# The only place Meetily keeps the real meeting title and its own generated summary;
# the recording folder holds just an auto-generated name. Mount read-only, or leave
# empty and let a summary.json sidecar supply the title instead.
# Host path: %APPDATA%\com.meetily.ai\meeting_minutes.sqlite
MEETING_ATLAS_MEETILY_DB=

# --- display ---------------------------------------------------------------------
# Recording timestamps are UTC; everything a user reads is local. Getting this wrong
# shifts every meeting by hours. Unknown names fall back to UTC.
MEETING_ATLAS_DISPLAY_TZ=America/Los_Angeles
MEETING_ATLAS_SERVE_AUDIO=true

# --- indexing --------------------------------------------------------------------
# Re-index on read when the mount looks changed, at most this often (seconds).
# Set 0 to make POST /api/reindex the only trigger — the intended setup once an
# ingest task owns writing sidecars and can call the hook itself.
MEETING_ATLAS_AUTOREINDEX_SECONDS=300
