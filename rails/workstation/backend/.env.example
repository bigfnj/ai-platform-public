# Workstation terminal backend — copy to .env for local dev, or set these on the
# container (see deploy/docker-compose.yml). Env prefix is WORKSTATION_.

# --- SSH target: the workstation's own sshd -------------------------------------
# host.docker.internal reaches the Docker host (Windows OpenSSH). Point at WSL or
# Kryptos by IP (e.g. 192.168.1.13) instead.
WORKSTATION_SSH_HOST=host.docker.internal
WORKSTATION_SSH_PORT=22
WORKSTATION_SSH_USER=
# Private key the backend logs in with (mounted read-only into the container).
WORKSTATION_SSH_KEY_PATH=/keys/id_workstation

# --- host-key verification ------------------------------------------------------
# Recommended: a known_hosts file holding the target's host key.
WORKSTATION_KNOWN_HOSTS_PATH=/keys/known_hosts
# First-run convenience ONLY — disables host-key checking. Leave false in normal use.
WORKSTATION_INSECURE_SKIP_HOST_KEY_CHECK=false

# --- terminal -------------------------------------------------------------------
WORKSTATION_TERM_TYPE=xterm-256color

# --- presets (optional) ---------------------------------------------------------
# JSON override of the default Shell / Claude Code / Codex tabs. Each: {id,label,icon,command}.
# command empty => login shell. Example that runs claude with resume:
# WORKSTATION_PRESETS_JSON=[{"id":"claude","label":"Claude Code","icon":"🤖","command":"claude --continue"}]
WORKSTATION_PRESETS_JSON=
