# Caddy in front of the platform gateway (the unified shell + reverse proxy).
#
# Plain HTTP only. Every site below is an http:// address and compose publishes only the
# container's port 80, as host port 1111 (docker-compose.yml, the caddy service's `ports`), so
# nothing here terminates TLS: where a tunnel fronts the box, public HTTPS ends at the tunnel's
# edge and arrives as plain HTTP. On this machine use http://localhost:1111 or
# http://platform.localhost:1111.
# `local_certs` does nothing while no site is https://; with it, a site added as https:// would be
# issued a certificate by Caddy's internal CA rather than by a public ACME one.
{
	local_certs
}

# Bare-HTTP LAN origins are NOT a secure context, and there is nothing the app or this
# proxy can send to change that — getUserMedia (the mic / dictation) is undefined there,
# and with PLATFORM_COOKIE_SECURE=true the session cookie will not stick either. So don't
# serve the app on them: 308-redirect to the one origin that is trustworthy end to end,
# the public HTTPS front door (TLS terminated at the tunnel's edge). 308 preserves the
# method and the full path+query, so a deep link survives the bounce.
http://lan-host, http://192.0.2.11 {
	redir https://platform.example.com{uri} 308
}

# Served directly (NOT redirected):
#   * platform.localhost is a secure context over plain HTTP — browsers treat *.localhost as
#     potentially trustworthy — so on-box use gets the mic without any TLS setup.
#   * bare localhost is equally a secure context, and is what a new user actually types (it is
#     also what docs/INSTALL.md tells them to open, since a managed browser can route *.localhost
#     through a corporate proxy). Without it Caddy matches NO site and answers 200 with an EMPTY
#     body — a blank page with no error anywhere, which is the worst possible failure mode.
#   * 127.0.0.1 is the same loopback typed as a literal, and a secure context too. Caddy picks a
#     site by the request's Host, so it matched none and got that same empty 200.
#   * platform.example.com arrives here through a tunnel with public HTTPS already
#     terminated at the tunnel's edge, reaching us over loopback. Redirecting it would loop;
#     the http->https hop is the tunnel's job, not ours.
http://localhost, http://127.0.0.1, http://platform.localhost, http://platform.example.com {
	encode zstd gzip
	reverse_proxy gateway:8700
}
