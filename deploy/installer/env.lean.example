# Lean install environment (8 GB VRAM, no media/image pipeline, no HuggingFace token).
# The installer copies this to deploy/.env and fills the double-brace placeholders from the wizard.
# The full-stack .env (24 GB box, media on, board API keys) is documented in CLAUDE.local.md.

# --- super-admin (from the installer wizard) ---
PLATFORM_ADMIN_USER={{ADMIN_USER}}
PLATFORM_ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# --- which rails are installed (from the chooser; admin/shell is always present) ---
# The gateway only proxies + serves rails listed here. Default lean set: terminal-fun (+ recipe-book if chosen).
PLATFORM_ENABLED_APPS={{ENABLED_APPS}}

# --- local, http, single box ---
PLATFORM_COOKIE_SECURE=false

# --- rail models: @role, never a pinned model name ---
# roles.lean.json points every role at the 8 GB model (gemma3:4b / bge-m3), so this is equivalent
# to the old concrete pins — but a pinned name here silently overrides Admin → Rails, making that
# panel look broken. Leave these as roles unless you mean to override one rail permanently.
RECIPE_BOOK_ASSISTANT_MODEL=@recipe
RECIPE_BOOK_VISION_MODEL=@recipe-vision
RECIPE_BOOK_EMBED_MODEL=@embed
TERMINAL_FUN_LLM_MODEL=@terminal-fun
CO_WORKER_SYNTHESIS_MODEL=@co-worker-synthesis
SMB_PARTNER_RAG_MODEL=@smb-partner-rag
SMB_PARTNER_EMBED_MODEL=@embed
GEMINI_CX_RAG_MODEL=@gemini-cx-rag
GEMINI_CX_EMBED_MODEL=@embed

# --- meeting-atlas: the recordings tree (only if meeting-atlas is installed) ---
# The rail READS both of these; it never writes to either. Unset = empty named volumes, which
# renders an empty rail rather than failing to start.
# MEETING_ATLAS_RECORDINGS_MOUNT=C:/Users/you/Music/meetily-recordings
#
# OPTIONAL, and note this is the database FILE, not the directory holding it: the mount target
# inside the container is /data/meetily.db. Without it, meeting titles come from summary.json
# sidecars instead of Meetily's own. There used to be a second variable naming the in-container
# path; it is gone, and an .env carrying it will bind a directory onto a file path.
# MEETING_ATLAS_MEETILY_DB_MOUNT=C:/Users/you/AppData/Roaming/com.meetily.ai/meeting_minutes.sqlite

# --- co-worker: where the host-side harvester drops items (only if co-worker is installed) ---
# The rail READS this directory; an external process on the Windows host writes it. Unset = an
# empty named volume, which renders an empty dashboard rather than failing to start.
# CO_WORKER_INBOX_MOUNT=/mnt/c/Users/you/ai-platform/data/co-worker/inbox

# --- NOTE: broker media pipeline is OFF for the lean install ---
# BROKER_MEDIA_ENABLED=false is set on the broker's NSSM service (AppEnvironmentExtra), not here,
# because the broker runs natively (not in compose). No CUDA media venv, no FLUX/SDXL, no HF token.
# Recipe icons ship pre-rendered in the seed (rails/recipe-book/seed/icons.tgz), so nothing renders.
