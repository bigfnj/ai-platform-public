# Lean install environment (8 GB VRAM, no media/image pipeline, no HuggingFace token).
# The installer copies this to deploy/.env and fills in the {{PLACEHOLDERS}} from the wizard.
# The full-stack .env (24 GB box, media on, board API keys) is documented in CLAUDE.local.md.

# --- super-admin (from the installer wizard) ---
PLATFORM_ADMIN_USER={{ADMIN_USER}}
PLATFORM_ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# --- which rails are installed (from the chooser; admin/shell is always present) ---
# The gateway only proxies + serves rails listed here. Default lean set: terminal-fun (+ recipe-book if chosen).
PLATFORM_ENABLED_APPS={{ENABLED_APPS}}

# --- local, http, single box ---
PLATFORM_COOKIE_SECURE=false

# --- container -> Windows-host wiring (written by the installer, not by hand) ---
# WINDOWS_HOST is the address containers use for the NATIVE broker (:11500) and Ollama (:11434).
#   podman  - gvproxy's host address (gvproxy runs on Windows and dials over the host's own
#             loopback, so no firewall rule is needed and a 127.0.0.1-only bind still works)
#   wsl     - the WSL->Windows gateway IP; DYNAMIC, so it is re-detected on every logon
#   desktop - left unset; Docker Desktop resolves the literal `host-gateway` itself
# WINDOWS_HOST=
#
# The Co-Worker rail reads an inbox that a process on the Windows host writes into, so the container
# bind-mounts it. _WIN is the Windows path; _MOUNT is that path as the runtime needs to see it
# (identical for podman/desktop, /mnt/<drive>/... for WSL). Both are written by the installer.
# CO_WORKER_INBOX_WIN=
# CO_WORKER_INBOX_MOUNT=

# --- per-rail models: leave these as @roles ---
# Every rail's model reference points at its own broker @role, which is what makes
# Admin -> Rails authoritative: repointing a role there changes the rail immediately
# (roles.json is hot-read, no restart). The lean 8 GB models are set ONCE, in
# services/broker/roles.json (from roles.lean.json) — not here.
#
# Pinning a concrete model name below would silently override the admin panel: the panel
# would show the new model and the rail would keep using the pin, with nothing to say so.
# Only do it to force one rail off its role deliberately.
RECIPE_BOOK_ASSISTANT_MODEL=@recipe
RECIPE_BOOK_VISION_MODEL=@recipe-vision
RECIPE_BOOK_ICON_MODEL=@recipe-icon
RECIPE_BOOK_EMBED_MODEL=@embed
TERMINAL_FUN_LLM_MODEL=@terminal-fun
CO_WORKER_SYNTHESIS_MODEL=@co-worker-synthesis
GEMINI_CX_RAG_MODEL=@gemini-cx-rag
GEMINI_CX_EMBED_MODEL=@embed
# Deliberately a concrete pin, not a role: this is only recipe-book's defensive fallback for a
# chat() call that passes no model (every caller passes one), and it has no role of its own —
# the generic @chat is shared with other rails and is not editable from the Rails panel.
RECIPE_BOOK_LLM_MODEL=gemma3:4b

# --- NOTE: broker media pipeline is OFF for the lean install ---
# BROKER_MEDIA_ENABLED=false is set on the broker's NSSM service (AppEnvironmentExtra), not here,
# because the broker runs natively (not in compose). No CUDA media venv, no FLUX/SDXL, no HF token.
# Recipe icons ship pre-rendered in the seed (rails/recipe-book/seed/icons.tgz), so nothing renders.
