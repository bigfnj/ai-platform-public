# Lean install environment (8 GB VRAM, no media/image pipeline, no HuggingFace token).
# The installer copies this to deploy/.env and fills in the {{PLACEHOLDERS}} from the wizard.
# The full-stack .env (24 GB box, media on, board API keys) is documented in CLAUDE.local.md.

# --- super-admin (from the installer wizard) ---
PLATFORM_ADMIN_USER={{ADMIN_USER}}
PLATFORM_ADMIN_PASSWORD={{ADMIN_PASSWORD}}

# --- which rails are installed (from the chooser; admin/shell is always present) ---
# The gateway only proxies + serves rails listed here. Default lean set: terminal-fun (+ recipe-book if chosen).
PLATFORM_ENABLED_APPS={{ENABLED_APPS}}

# --- local, http, single box ---
PLATFORM_COOKIE_SECURE=false

# --- recipe-book on the lean model (only used if recipe-book is installed) ---
# Overrides its full-stack defaults (mistral-small:24b / gemma3:27b) down to the 8 GB model.
RECIPE_BOOK_LLM_MODEL=gemma3:4b
RECIPE_BOOK_ASSISTANT_MODEL=gemma3:4b
RECIPE_BOOK_VISION_MODEL=gemma3:4b
RECIPE_BOOK_EMBED_MODEL=bge-m3

# --- NOTE: broker media pipeline is OFF for the lean install ---
# BROKER_MEDIA_ENABLED=false is set on the broker's NSSM service (AppEnvironmentExtra), not here,
# because the broker runs natively (not in compose). No CUDA media venv, no FLUX/SDXL, no HF token.
# Recipe icons ship pre-rendered in the seed (rails/recipe-book/seed/icons.tgz), so nothing renders.
