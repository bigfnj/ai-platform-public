# Copy to `.env` (same folder) and set before `docker compose up`. All optional.

# Initial admin, seeded on FIRST run only (when the auth DB is empty).
# If PLATFORM_ADMIN_PASSWORD is left blank, the gateway generates a strong random
# password and prints it ONCE to its log:  docker compose logs gateway
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=

# Session-cookie hardening. Set to true the moment you serve over HTTPS / expose
# the platform publicly (see INSTRUCTIONS.md "Enable HTTPS"). Leave false for local
# http://platform.localhost, or the browser won't send the session cookie back.
PLATFORM_COOKIE_SECURE=false

# --- Co-Worker rail: host bind-mounts ----------------------------------------
# Both are optional. Each falls back to an empty named volume, which yields an
# empty dashboard / hidden prompts panel rather than a startup failure.
#
# Docker Desktop on Windows uses forward slashes with a drive letter:
#   CO_WORKER_INBOX_MOUNT=C:/Users/you/ai-platform/data/co-worker/inbox
# WSL-style paths also work:
#   CO_WORKER_INBOX_MOUNT=/c/Users/you/ai-platform/data/co-worker/inbox

# Where the harvest loops drop JSON items. Point at $AI/data/co-worker/inbox
# (the same directory the scheduled co-work tasks write to).
CO_WORKER_INBOX_MOUNT=

# The scheduler's job directory, mounted READ-ONLY. One subdir per job, each with
# a SKILL.md. Powers the "Co-Work Prompts" panel in the dashboard.
# On Windows: CO_WORKER_PROMPTS_MOUNT=C:/Users/you/Claude/Scheduled
# Leave blank to hide the panel. Never put this path in the repo — these prompts
# embed personal and client identifiers and rails/ is public.
CO_WORKER_PROMPTS_MOUNT=

# --- Meeting Atlas -------------------------------------------------------------
# The Meetily recordings tree on the host, bind-mounted READ-ONLY into the rail.
# On Windows:  MEETING_ATLAS_RECORDINGS_MOUNT=C:/Users/you/Music/meetily-recordings
# Git Bash style also works: /c/Users/you/Music/meetily-recordings
# Leave empty to fall back to an empty named volume (the rail renders an empty state).
MEETING_ATLAS_RECORDINGS_MOUNT=

# OPTIONAL. The Meetily SQLite is the only place the real meeting TITLE and Meetily's
# own generated summary live; the recording folder holds just an auto-generated name.
# Mount the DIRECTORY containing it, then point the in-container path at the file:
#   MEETING_ATLAS_MEETILY_DB_MOUNT=C:/Users/you/AppData/Roaming/com.meetily.ai
#   MEETING_ATLAS_MEETILY_DB_IN_CONTAINER=/data/meetily/meeting_minutes.sqlite
# Leave both empty to rely on summary.json sidecars supplying the title instead.
MEETING_ATLAS_MEETILY_DB_MOUNT=
MEETING_ATLAS_MEETILY_DB_IN_CONTAINER=

# Re-index on read when the mount looks changed, at most this often (seconds).
# Set 0 once an ingest task calls POST /meeting-atlas/api/reindex itself.
MEETING_ATLAS_AUTOREINDEX_SECONDS=300
