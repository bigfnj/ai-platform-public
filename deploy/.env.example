# Copy to `.env` (same folder) and set before `docker compose up`. All optional.

# Initial admin, seeded on FIRST run only (when the auth DB is empty).
# If PLATFORM_ADMIN_PASSWORD is left blank, the gateway generates a strong random
# password and prints it ONCE to its log:  docker compose logs gateway
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=

# Session-cookie hardening. Set to true the moment you serve over HTTPS / expose
# the platform publicly (see INSTRUCTIONS.md "Enable HTTPS"). Leave false for local
# http://platform.localhost, or the browser won't send the session cookie back.
PLATFORM_COOKIE_SECURE=false

# Local display timezone. Recordings and harvested items carry UTC timestamps; every rail that
# shows a time converts with this. A wrong value shifts everything by hours while looking
# entirely plausible, which is the worst way for a clock to be wrong.
TZ=America/Los_Angeles

# --- Broker control plane --------------------------------------------------
# One platform-wide shared secret. Compose passes it to every broker client; the broker enforces
# it ONLY when set, so leaving it empty keeps a dev box open. Set it and the broker stops
# accepting unauthenticated /v1/* calls from anything on the LAN or in any container.
#
# It has to be set in TWO places, and clients FIRST or you get a 401 gap: here (compose picks it
# up on the next `up`), then on the broker's own service environment, then restart the broker.
BROKER_AUTH_TOKEN=

# --- Meeting Atlas ---------------------------------------------------------
# Both mounts are OPTIONAL and both are read-only; the rail never writes to either. Left blank,
# compose falls back to empty named volumes, which yields an empty rail rather than a crash.

# The Meetily recordings tree.
MEETING_ATLAS_RECORDINGS_MOUNT=

# The Meetily SQLite — the only place the real meeting title and Meetily's own summary live.
# ⚠ This is the database FILE, not the directory holding it: it mounts at /data/meetily.db and
# MEETING_ATLAS_MEETILY_DB is derived from it. There used to be a second variable naming the
# in-container path; it is gone, and an .env still carrying the old DIRECTORY form here will bind
# a directory onto a file path. Without this, titles come from summary.json sidecars instead.
#   MEETING_ATLAS_MEETILY_DB_MOUNT=C:/Users/you/AppData/Roaming/com.meetily.ai/meeting_minutes.sqlite
MEETING_ATLAS_MEETILY_DB_MOUNT=

# --- Co-Worker -------------------------------------------------------------
# Both mounts are OPTIONAL. Left blank, compose falls back to an empty named volume,
# which yields an empty dashboard / hidden prompts panel rather than a startup failure.
#
# Docker Desktop on Windows uses forward slashes with a drive letter:
#   CO_WORKER_INBOX_MOUNT=D:/.ai-work/data/co-worker/inbox
# WSL-style paths also work:
#   CO_WORKER_INBOX_MOUNT=/d/.ai-work/data/co-worker/inbox

# Where the harvest loops drop JSON items — the same directory the scheduled
# co-work tasks write to.
CO_WORKER_INBOX_MOUNT=

# The scheduler's job directory, mounted READ-ONLY. One subdir per job, each with
# a SKILL.md. Powers the "Co-Work Prompts" panel in the dashboard.
# On Windows: CO_WORKER_PROMPTS_MOUNT=C:/Users/you/Claude/Scheduled
# Leave blank to hide the panel.
CO_WORKER_PROMPTS_MOUNT=
