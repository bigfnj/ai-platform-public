*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
*.local
# local-only agent ops notes (machine-specific: hosting, native services, secret locations)
CLAUDE.local.md
# workstation terminal: SSH key(s) the backend logs in with — never commit
deploy/workstation-keys/
# transient logs anywhere in the repo — operational output, not tracked
*.log
# co-worker harvest output — real email/calendar/Teams intelligence: client names, colleague
# names, ticket ids, and the learned org context in CONTEXT.md. THIS REPO IS PUBLIC.
# Machine-local runtime data only; never commit.
data/

# Node / web (future)
node_modules/
dist/
.vite/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# rails removed from the active lean stack but still present on some dev workstation disks
rails/bouquet/

# co-worker harvest PROMPTS — they embed the owner's real name, work email, job title, employer
# and local Claude scheduled-job paths. THIS REPO IS PUBLIC. Keep them machine-local; BriefView
# imports this module, so a public clone needs a sanitised prompts.example.ts instead.
rails/co-worker/frontend/src/prompts.ts

# AI-assistant leftovers — keep agent context/memory/rules out of the public repo
.claude/
CLAUDE.md
.cursor/
.cursorrules
.aider*
.windsurfrules
.github/copilot-instructions.md
AGENTS.md

# SMB Partner Enablement — rebuild source material. Real internal correspondence, decks,
# SharePoint links and colleague contact details. This repo is PUBLIC: these stay local.
rails/smb-partner-enablement/research/
rails/smb-partner-enablement/documents/
rails/smb-partner-enablement/build/
rails/smb-partner-enablement/*.egg-info/

# Downloaded model weights. The broker's Kokoro TTS needs kokoro-v1.0.fp16-gpu.onnx (170 MB)
# and voices-v1.0.bin (27 MB); faster-whisper pulls its own into the HuggingFace cache. None of
# it belongs in git: GitHub HARD-REJECTS any file over 100 MB, so a `git add -A` here produces a
# push that cannot succeed and a local history you have to rewrite to fix. Weights are a
# download step (BROKER_KOKORO_MODEL_PATH / BROKER_KOKORO_VOICES_PATH point at them).
services/broker/media-assets/
*.onnx
*.gguf
*.safetensors
*.pt
*.pth
