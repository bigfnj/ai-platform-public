# Keep the gateway build context small. It only needs platform_core + the gateway
# backend (Python); never the venv, node_modules, built dists, or git history.
.git
.venv
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/node_modules
**/dist

# Logs are appended by the running broker/watchdog while the context is being
# tarred, which fails the build with "archive/tar: write too long".
deploy/logs
**/*.log
